@model NguyenDinhSang_241230832.Models.HangHoa

@{
    ViewData["Title"] = "Chi tiết hàng hóa";
    Layout = "~/Views/Shared/NguyenDinhSang_Layout.cshtml";
}
<!-- Begin Main -->
<div class="main" style="padding: 30px 0;">
    <div class="content">
        <div class="content_top">
            <div class="heading">
                <h3 style="color: red; text-transform: uppercase; font-weight: bold;">CHI TIẾT HÀNG HÓA</h3>
            </div>
            <div class="see">
                <p><a href="@Url.Action("Index", "Home")">Quay lại trang chủ</a></p>
            </div>
            <div class="clear"></div>
        </div>

        <div class="section group" style="background: #fff; padding: 20px; border: 1px solid #EBEBEB; display: flex; gap: 40px; align-items: center;">
            <div style="flex: 1; text-align: center;">
                @if (!string.IsNullOrEmpty(Model.Anh))
                {
                    <img src="~/images/@Model.Anh" alt="@Model.TenHang" style="max-width: 100%; height: 250px; object-fit: cover; border-radius: 4px;" />
                }
                else
                {
                    <img src="~/images/feature-pic1.jpg" alt="" style="max-width: 100%; height: 250px; object-fit: cover;" />
                }
            </div>
            <div style="flex: 2;">
                <h2 style="font-size: 24px; color: #333; margin-bottom: 15px;">@Model.TenHang</h2>
                <p style="font-size: 18px; margin-bottom: 15px;">
                    <strong>Giá bán:</strong> 
                    <span style="color: red; font-weight: bold;">@Model.Gia.ToString() </span>
                </p>
                <p style="margin-bottom: 20px; color: #666;">
                    <strong>Mã hàng hóa:</strong> @Model.MaHang
                </p>
                
                <div class="add-cart">
                    <a href="@Url.Action("Index", "Home")" style="padding: 10px 20px; background: #db1c25; color: #fff; text-decoration: none; border-radius: 3px; font-weight: bold;">Trở về danh sách</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Main -->