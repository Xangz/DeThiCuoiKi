@model NguyenDinhSang_241230832.Models.HangHoa

@{
    ViewData["Title"] = "Thêm hàng hóa mới";
    Layout = "~/Views/Shared/NguyenDinhSang_Layout.cshtml";
}
<div class="main" style="padding: 20px 0;">
    <div class="content">
        <div class="content_top">
            <div class="heading">
                <h3 style="color: red; text-transform: uppercase; font-weight: bold;">NGUYỄN ĐÌNH SANG</h3>
            </div>
            <div class="clear"></div>
        </div>

        <div style="padding: 10px 0;">
            <p style="font-weight: bold; margin-bottom: 15px;">Thêm Hàng Hóa Mới</p>

            <form asp-action="Create" method="post" style="max-width: 400px;">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group" style="margin-bottom: 15px;">
                    <label asp-for="MaLoai" class="control-label" style="display: block; font-weight: bold; margin-bottom: 5px;">MaLoai</label>
                    <select asp-for="MaLoai" class="form-control" asp-items="ViewBag.MaLoai" style="width: 100%; padding: 6px;"></select>
                    <span asp-validation-for="MaLoai" class="text-danger" style="color: red; font-size: 13px;"></span>
                </div>
                <div class="form-group" style="margin-bottom: 15px;">
                    <label asp-for="TenHang" class="control-label" style="display: block; font-weight: bold; margin-bottom: 5px;">TenHang</label>
                    <input asp-for="TenHang" class="form-control" style="width: 100%; padding: 6px;" />
                    <span asp-validation-for="TenHang" class="text-danger" style="color: red; font-size: 13px;"></span>
                </div>
                <div class="form-group" style="margin-bottom: 15px;">
                    <label asp-for="Gia" class="control-label" style="display: block; font-weight: bold; margin-bottom: 5px;">Gia</label>
                    <input asp-for="Gia" class="form-control" style="width: 100%; padding: 6px;" />
                    <span asp-validation-for="Gia" class="text-danger" style="color: red; font-size: 13px;"></span>
                </div>
                <div class="form-group" style="margin-bottom: 15px;">
                    <label asp-for="Anh" class="control-label" style="display: block; font-weight: bold; margin-bottom: 5px;">Anh</label>
                    <input asp-for="Anh" class="form-control" style="width: 100%; padding: 6px;" />
                    <span asp-validation-for="Anh" class="text-danger" style="color: red; font-size: 13px;"></span>
                </div>
                <div class="form-group" style="margin-top: 15px;">
                    <input type="submit" value="Create" style="padding: 6px 15px; background: #e4e4e4; border: 1px solid #ccc; cursor: pointer;" />
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}